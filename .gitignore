# Local-only evidence gathering — never committed (owner decision, 2026-10-24)
evidence/

# Internal work tracking — retained locally, never published
/docs/tracking.md

# Installed dependencies and generated build output
node_modules/

# Local planning state
.slim/

# Runtime databases, SQLite sidecars, and logs
*.sqlite
*.sqlite3
*.db
*-journal
*-wal
*-shm
*.log

# Local environment and secrets (keep a safe example file trackable)
.env*
!.env.example

# Git installs consume built entries directly; everything else stays local.
# Keep this after generic exceptions so even build/**/.env.example stays ignored.
/build/*
!/build/service/
/build/service/*
!/build/service/main.js
!/build/companion/
/build/companion/*
!/build/companion/index.js
!/build/companion/package.json
!/build/companion/SKILL.md
!/build/setup/
/build/setup/*
!/build/setup/main.js

# Editor and IDE state (shared run configurations and settings stay trackable)
.idea/*
!.idea/codeStyles/
!.idea/runConfigurations/
*.iml
*.iws
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
.history/
.DS_Store
Thumbs.db

# Node and package-manager logs, caches and reports
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
.npm/
.eslintcache
.stylelintcache
.node_repl_history
*.tsbuildinfo
.cache/
.temp/
.yarn-integrity
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# Test coverage output
coverage/
*.lcov
.nyc_output/

# Packed tarballs
*.tgz

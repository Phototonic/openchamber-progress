{
  "name": "openchamber-agent-progress-probe",
  "version": "1.5.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "openchamber": {
    "apiVersion": 1,
    "engines": { "openchamber": ">=2.7.1" },
    "contributes": {
      "opencodePlugin": "build/companion",
      "tools": [
        { "match": "agent_progress_report", "name": "Agent progress report", "icon": "list-check-2", "output": "text" }
      ],
      "panel": { "id": "agent-progress-probe", "name": "Agent progress", "icon": "checkbox-circle", "entry": "ui/panel/index.html", "mobile": true },
      "statusSection": { "entry": "ui/status/index.html", "title": "Agent progress", "height": 160 },
      "page": { "entry": "ui/page/index.html", "title": "Agent progress", "mobile": true },
      "background": { "entry": "background/index.html" },
      "actions": [
        { "id": "open-progress", "label": "Open Agent Progress", "where": "session", "mode": "open" },
        { "id": "insert-handoff", "label": "Insert handoff", "where": "session", "mode": "background" },
        { "id": "insert-progress-update", "label": "Insert progress update", "where": "session", "mode": "background" }
      ],
      "mentions": { "label": "Agent progress" },
      "attach": false,
      "capabilities": ["sessions"],
      "service": { "entry": "build/service/main.js", "runtime": "host", "permissions": {} }
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:backend": "bun run build:all && node --experimental-strip-types --test tests/backend/*.test.ts",
    "build:backend": "bun scripts/build.ts",
    "build:all": "node --experimental-strip-types scripts/build-all.ts",
    "build": "bun run build:all",
    "promote": "node --experimental-strip-types scripts/promote.ts",
    "package": "bun run build:all && node --experimental-strip-types scripts/package.ts",
    "verify:package": "bun run build:all && node --experimental-strip-types scripts/verify-package.ts",
    "bundle:guest": "openchamber-guest-bundle",
    "prepare:probe": "bun run build:all && bun scripts/prepare-probe.ts",
    "setup": "bun run build:all && node build/setup/main.js",
    "check": "bun run build:all && bun run typecheck && node --experimental-strip-types --test tests/backend/*.test.ts && node --experimental-strip-types scripts/package.ts && node --experimental-strip-types scripts/verify-package.ts"
  },
  "dependencies": {
    "@openchamber/sdk": "2.7.1",
    "@opencode/plugin": "2.1.4"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "5.9.3"
  }
}
